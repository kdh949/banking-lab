{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banking-lab.synthetic/contracts/events/payment-instruction-failed.schema.json",
  "title": "PaymentInstructionFailed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "paymentInstructionId",
    "paymentAttemptId",
    "status",
    "failureCode",
    "errorMessage",
    "retryable",
    "retryCount",
    "deadLetterThreshold",
    "syntheticOnly",
    "directLedgerWrite",
    "realPaymentNetworkUsed",
    "realFinancialInstitutionApiUsed"
  ],
  "properties": {
    "contractVersion": { "const": "2026-06-05" },
    "paymentInstructionId": { "type": "string", "pattern": "^PAY-" },
    "paymentAttemptId": { "type": "string", "pattern": "^PAT-" },
    "status": { "const": "FAILED" },
    "failureCode": { "type": "string", "minLength": 1, "maxLength": 80 },
    "errorMessage": { "type": "string", "maxLength": 500 },
    "retryable": { "const": true },
    "retryCount": { "type": "integer", "minimum": 1 },
    "deadLetterThreshold": { "type": "integer", "minimum": 1 },
    "syntheticOnly": { "const": true },
    "directLedgerWrite": { "const": false },
    "realPaymentNetworkUsed": { "const": false },
    "realFinancialInstitutionApiUsed": { "const": false }
  }
}
