# Banking Lab local synthetic environment only.
# Copy values into a private .env file if needed. Do not commit real secrets,
# real customer data, real payment-network credentials, or real KYC provider data.

BANKING_LAB_SYNTHETIC_ONLY=true

# Local development database credentials. These defaults are intentionally
# synthetic and are blocked by the Spring prod-like profile guard.
BANKING_LAB_DATABASE_URL=jdbc:postgresql://localhost:5432/banking_lab
BANKING_LAB_DATABASE_USER=banking_lab
BANKING_LAB_DATABASE_PASSWORD=replace-with-local-synthetic-password

BANKING_LAB_PAYMENT_DATABASE_URL=jdbc:postgresql://localhost:5432/banking_lab_payment
BANKING_LAB_PAYMENT_DATABASE_USER=banking_lab
BANKING_LAB_PAYMENT_DATABASE_PASSWORD=replace-with-local-synthetic-password

BANKING_LAB_NOTIFICATION_DATABASE_URL=jdbc:postgresql://localhost:5432/banking_lab_notification
BANKING_LAB_NOTIFICATION_DATABASE_USER=banking_lab
BANKING_LAB_NOTIFICATION_DATABASE_PASSWORD=replace-with-local-synthetic-password

BANKING_LAB_REPORTING_DATABASE_URL=jdbc:postgresql://localhost:5432/banking_lab_reporting
BANKING_LAB_REPORTING_DATABASE_USER=banking_lab
BANKING_LAB_REPORTING_DATABASE_PASSWORD=replace-with-local-synthetic-password

# Security defaults. Simulator tokens are local development only and must
# stay disabled for prod-like profiles.
BANKING_LAB_SECURITY_ENABLED=true
BANKING_LAB_SECURITY_SIMULATOR_TOKENS_ENABLED=false
BANKING_LAB_DEV_SIMULATOR_TOKEN=false
BANKING_LAB_SECURITY_JWKS_URI=http://localhost:8085/realms/banking-lab/protocol/openid-connect/certs
BANKING_LAB_SECURITY_ISSUER=http://localhost:8085/realms/banking-lab
BANKING_LAB_SECURITY_AUDIENCE=core-banking-api
BANKING_LAB_SECURITY_TRUSTED_DEVICE_ENFORCEMENT_ENABLED=true
BANKING_LAB_SECURITY_STEP_UP_ENFORCEMENT_ENABLED=true
BANKING_LAB_SECURITY_SESSION_ENFORCEMENT_ENABLED=true

# Synthetic service-to-service credentials. Replace only in private local env
# or secret manager material; never commit real values.
BANKING_LAB_PAYMENT_CORE_BANKING_CLIENT_ID=payment-service-api
BANKING_LAB_PAYMENT_CORE_BANKING_CLIENT_SECRET=replace-with-local-synthetic-payment-service-client-secret
BANKING_LAB_PAYMENT_CORE_BANKING_SERVICE_TOKEN=replace-with-local-synthetic-service-token

# Local platform ports and observability endpoints.
BANKING_LAB_POSTGRES_PORT=5432
BANKING_LAB_CORE_BANKING_PORT=8081
BANKING_LAB_PAYMENT_SERVICE_PORT=8088
BANKING_LAB_NOTIFICATION_SERVICE_PORT=8089
BANKING_LAB_REPORTING_SERVICE_PORT=8090
BANKING_LAB_KEYCLOAK_PORT=8085
BANKING_LAB_REDPANDA_PORT=9092
BANKING_LAB_TEMPORAL_PORT=7233
BANKING_LAB_PROMETHEUS_PORT=9090
BANKING_LAB_GRAFANA_PORT=3001
BANKING_LAB_LOKI_PORT=3100
BANKING_LAB_TEMPO_PORT=3200
BANKING_LAB_TRACING_ENABLED=true
BANKING_LAB_OTLP_TRACING_EXPORT_ENABLED=true
BANKING_LAB_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
