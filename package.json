{
  "name": "banking-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bank-grade Core Banking Lab foundation scaffold with synthetic data only.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    },
    "postcss": "8.5.10"
  },
  "scripts": {
    "start": "node runtime/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:core-banking": "scripts/run-core-banking-tests.sh",
    "test:core-banking:rerun": "scripts/run-core-banking-tests.sh --rerun-tasks",
    "test:core-banking:unit": "scripts/run-core-banking-tests.sh :services:core-banking:test",
    "test:core-banking:integration": "scripts/run-core-banking-tests.sh :services:core-banking:integrationTest",
    "test:screen-engine": "npm --workspace @banking-lab/screen-engine run test",
    "parity": "node --experimental-strip-types scripts/run-parity-checks.ts",
    "node:retirement-gate": "node --experimental-strip-types scripts/check-node-retirement-gate.ts",
    "retirement:audit": "node --experimental-strip-types scripts/check-retirement-boundary-audit.ts",
    "retirement:stack-audit": "node --experimental-strip-types scripts/check-stack-retirement-by-area.ts",
    "retirement:generated-boundary": "node --experimental-strip-types scripts/check-generated-artifact-boundary.ts",
    "passkey:evidence:record": "node --experimental-strip-types scripts/record-passkey-non-synthetic-evidence.ts",
    "passkey:evidence:verify": "node --experimental-strip-types scripts/verify-passkey-non-synthetic-evidence.ts",
    "passkey:evidence:preflight": "node --experimental-strip-types scripts/check-passkey-non-synthetic-preflight.ts",
    "evidence:refresh-check": "node --experimental-strip-types scripts/check-evidence-refresh.ts",
    "retirement:review-preflight": "node --experimental-strip-types scripts/check-retirement-review-preflight.ts",
    "retirement:final-review:verify": "node --experimental-strip-types scripts/verify-final-retirement-review.ts",
    "goal:completion-audit": "node --experimental-strip-types scripts/check-goal-completion-audit.ts",
    "next:customer-web": "npm --workspace @banking-lab/customer-web run dev",
    "next:customer-web:build": "npm --workspace @banking-lab/customer-web run build",
    "next:customer-web:typecheck": "npm --workspace @banking-lab/customer-web run typecheck",
    "next:staff-terminal": "npm --workspace @banking-lab/staff-terminal run dev",
    "next:staff-terminal:build": "npm --workspace @banking-lab/staff-terminal run build",
    "next:staff-terminal:typecheck": "npm --workspace @banking-lab/staff-terminal run typecheck",
    "next:complaint-portal": "npm --workspace @banking-lab/complaint-portal run dev",
    "next:complaint-portal:build": "npm --workspace @banking-lab/complaint-portal run build",
    "next:complaint-portal:typecheck": "npm --workspace @banking-lab/complaint-portal run typecheck",
    "next:ops-console": "npm --workspace @banking-lab/ops-console run dev",
    "next:ops-console:build": "npm --workspace @banking-lab/ops-console run build",
    "next:ops-console:typecheck": "npm --workspace @banking-lab/ops-console run typecheck",
    "next:audit-console": "npm --workspace @banking-lab/audit-console run dev",
    "next:audit-console:build": "npm --workspace @banking-lab/audit-console run build",
    "next:audit-console:typecheck": "npm --workspace @banking-lab/audit-console run typecheck",
    "next:fds-aml-console": "npm --workspace @banking-lab/fds-aml-console run dev",
    "next:fds-aml-console:build": "npm --workspace @banking-lab/fds-aml-console run build",
    "next:fds-aml-console:typecheck": "npm --workspace @banking-lab/fds-aml-console run typecheck",
    "next:admin-console": "npm --workspace @banking-lab/admin-console run dev",
    "next:admin-console:build": "npm --workspace @banking-lab/admin-console run build",
    "next:admin-console:typecheck": "npm --workspace @banking-lab/admin-console run typecheck",
    "packages:typecheck": "npm --workspace @banking-lab/screen-engine run typecheck && npm --workspace @banking-lab/form-engine run typecheck && npm --workspace @banking-lab/api-client run typecheck && npm --workspace @banking-lab/auth-client run typecheck",
    "scripts:typecheck": "tsc -p scripts/tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "validate:manifests": "node --experimental-strip-types scripts/validate-manifests.ts",
    "security:evidence": "node --experimental-strip-types scripts/run-security-evidence.ts",
    "generate:synthetic-data": "node scripts/generate-synthetic-data.mjs",
    "evidence:phase1": "node scripts/generate-phase1-evidence.mjs",
    "evidence:phase2": "node scripts/generate-phase2-evidence.mjs",
    "evidence:phase3": "node scripts/generate-phase3-evidence.mjs",
    "evidence:phase4": "node scripts/generate-phase4-evidence.mjs",
    "evidence:phase5": "node scripts/generate-phase5-evidence.mjs",
    "evidence:phase6": "node scripts/generate-phase6-evidence.mjs",
    "evidence:pack": "node scripts/generate-evidence-pack.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1"
  },
  "engines": {
    "node": ">=20"
  }
}
