{
  "name": "banking-lab",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "banking-lab",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*",
        "services/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@banking-lab/banking-domain": {
      "resolved": "packages/banking-domain",
      "link": true
    },
    "node_modules/@banking-lab/form-engine": {
      "resolved": "packages/form-engine",
      "link": true
    },
    "node_modules/@banking-lab/screen-engine": {
      "resolved": "packages/screen-engine",
      "link": true
    },
    "packages/banking-domain": {
      "name": "@banking-lab/banking-domain",
      "version": "0.1.0"
    },
    "packages/form-engine": {
      "name": "@banking-lab/form-engine",
      "version": "0.1.0"
    },
    "packages/screen-engine": {
      "name": "@banking-lab/screen-engine",
      "version": "0.1.0"
    }
  }
}
