{
  "screenId": "OPS-101",
  "transactionCode": "OPS101",
  "title": "Daily Closing Monitor",
  "app": "ops-console",
  "type": "DASHBOARD",
  "domain": "reconciliation",
  "requiredRoles": ["OPS_OPERATOR", "OPS_MANAGER"],
  "layout": {
    "template": "dashboard",
    "customerContext": false
  },
  "audit": {
    "enabled": true,
    "reasonRequired": false,
    "piiAccess": false,
    "maskingPolicy": "NONE"
  },
  "approval": {
    "required": true,
    "makerChecker": true,
    "businessTypes": ["EOD_CLOSING"]
  },
  "widgets": ["ledgerInvariantStatus", "closingStatus", "unmatchedItems"],
  "actions": [
    {
      "id": "readEodMonitor",
      "label": "Read Monitor",
      "type": "query",
      "target": "GET /api/ops/eod/{businessDate}"
    },
    {
      "id": "requestEodClose",
      "label": "Request Close",
      "type": "command",
      "target": "POST /api/ops/eod/close"
    }
  ]
}
