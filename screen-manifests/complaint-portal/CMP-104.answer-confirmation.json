{
  "screenId": "CMP-104",
  "transactionCode": "CMP104",
  "title": "Complaint Answer Confirmation",
  "app": "complaint-portal",
  "type": "CASE",
  "domain": "complaint",
  "requiredRoles": ["CUSTOMER"],
  "layout": {
    "template": "case",
    "customerContext": true
  },
  "workflow": {
    "name": "complaintWorkflow",
    "states": ["ANSWERED", "CUSTOMER_CONFIRMED", "CLOSED", "REOPENED"]
  },
  "sla": {
    "enabled": true,
    "targetHours": 72
  },
  "audit": {
    "enabled": true,
    "reasonRequired": false,
    "piiAccess": true,
    "selfService": true,
    "maskingPolicy": "CUSTOMER_SELF"
  },
  "sections": ["answer", "confirmation", "timeline"],
  "actions": [
    {
      "id": "confirmAnswer",
      "label": "Confirm Answer",
      "type": "command",
      "target": "POST /api/customer/complaints/{caseId}/confirm"
    }
  ]
}
