{
  "screenId": "CALL-105",
  "transactionCode": "CALL105",
  "title": "Call-Center Interaction History",
  "app": "call-center-console",
  "type": "INQUIRY",
  "domain": "call-center",
  "requiredRoles": ["CALL_CENTER_AGENT", "CALL_CENTER_MANAGER", "BRANCH_STAFF", "AUDITOR", "COMPLIANCE_MANAGER"],
  "layout": {
    "template": "inquiry",
    "customerContext": true
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": true,
    "maskingPolicy": "CALL_CENTER_MASKED",
    "eventTypes": ["CALL_CENTER_HISTORY_VIEW"]
  },
  "query": {
    "fields": [
      { "name": "customerId", "label": "Customer ID", "type": "text", "required": true },
      { "name": "reason", "label": "Business Reason", "type": "text", "required": true }
    ],
    "api": "GET /api/staff/call-center/customers/{customerId}/history"
  },
  "resultTable": {
    "columns": ["interactionId", "maskedCustomerName", "channel", "contactReasonCode", "status", "assignedTo", "startedAt", "endedAt"]
  },
  "sections": ["search", "resultTable", "detailPanel", "auditPanel"],
  "actions": [
    {
      "id": "viewInteraction",
      "label": "View Interaction",
      "type": "query",
      "target": "GET /api/staff/call-center/interactions/{interactionId}"
    }
  ]
}

