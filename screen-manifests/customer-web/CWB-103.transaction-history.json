{
  "screenId": "CWB-103",
  "transactionCode": "CWB103",
  "title": "Customer Transaction History",
  "app": "customer-web",
  "type": "INQUIRY",
  "domain": "ledger",
  "requiredRoles": ["CUSTOMER"],
  "layout": {
    "template": "inquiry",
    "customerContext": true
  },
  "audit": {
    "enabled": true,
    "reasonRequired": false,
    "piiAccess": false,
    "selfService": true,
    "maskingPolicy": "CUSTOMER_SELF",
    "eventTypes": ["TRANSACTION_HISTORY_VIEW", "STATEMENT_VIEW", "TRANSACTION_CONFIRMATION_VIEW", "BALANCE_CERTIFICATE_VIEW"]
  },
  "query": {
    "endpoint": "GET /api/customer/transactions",
    "clientMethod": "customerTransactions",
    "fields": [
      {
        "name": "accountId",
        "label": "Account ID",
        "type": "text",
        "required": true
      }
    ]
  },
  "resultTable": {
    "columns": ["transactionId", "transactionType", "businessDate", "status", "posting"]
  },
  "actions": [
    {
      "id": "readStatement",
      "label": "Read Statement",
      "type": "query",
      "target": "CWB-106"
    },
    {
      "id": "readTransactionConfirmation",
      "label": "Read Confirmation",
      "type": "query",
      "target": "GET /api/transactions/{transactionId}/confirmation"
    },
    {
      "id": "readBalanceCertificate",
      "label": "Read Balance Certificate",
      "type": "query",
      "target": "GET /api/accounts/{accountId}/balance-certificate"
    },
    {
      "id": "openTransfer",
      "label": "Open Transfer",
      "type": "navigate",
      "target": "CWB-201"
    }
  ],
  "api": {
    "query": "GET /api/customer/transactions",
    "clientMethod": "customerTransactions",
    "ownershipEnforced": true,
    "syntheticOnly": true
  }
}
