{
  "screenId": "CWB-703",
  "transactionCode": "CWB703",
  "title": "Synthetic Autopay Management",
  "app": "customer-web",
  "type": "COMMAND",
  "domain": "payment",
  "highRisk": false,
  "requiredRoles": ["CUSTOMER"],
  "layout": {
    "template": "command",
    "customerContext": true
  },
  "approval": {
    "required": false,
    "makerChecker": false
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": false,
    "maskingPolicy": "CUSTOMER_SELF"
  },
  "fields": [
    {
      "name": "agreementId",
      "label": "Agreement ID",
      "type": "text",
      "required": true
    },
    {
      "name": "nextRunOn",
      "label": "Resume Run Date",
      "type": "date",
      "required": false
    },
    {
      "name": "requestedBy",
      "label": "Requested By",
      "type": "text",
      "required": true
    },
    {
      "name": "idempotencyKey",
      "label": "Idempotency Key",
      "type": "text",
      "required": true
    },
    {
      "name": "reason",
      "label": "Change Reason",
      "type": "textarea",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/payments/autopay/agreements/{agreementId}/pause",
    "alternateResumeCommand": "POST /api/payments/autopay/agreements/{agreementId}/resume",
    "alternateCancelCommand": "POST /api/payments/autopay/agreements/{agreementId}/cancel",
    "read": "GET /api/payments/autopay/agreements/{agreementId}"
  },
  "postActions": ["createAuditEvent", "appendAutopayStatusHistory", "showAutopayStatus"]
}
