{
  "screenId": "CWB-004",
  "transactionCode": "CWB004",
  "title": "Self-Service Account Opening Request",
  "app": "customer-web",
  "type": "COMMAND",
  "domain": "account",
  "highRisk": false,
  "requiredRoles": ["CUSTOMER"],
  "layout": {
    "template": "command",
    "customerContext": true
  },
  "approval": {
    "required": false,
    "makerChecker": false,
    "deferredStaffMakerChecker": true
  },
  "audit": {
    "enabled": true,
    "reasonRequired": false,
    "piiAccess": false,
    "selfService": true,
    "maskingPolicy": "CUSTOMER_SELF",
    "eventTypes": ["CUSTOMER_ACCOUNT_OPENING_REQUESTED", "CUSTOMER_ACCOUNT_OPENING_STATUS_VIEW"]
  },
  "fields": [
    {
      "name": "idempotencyKey",
      "label": "Idempotency Key",
      "type": "generated-text",
      "required": true
    },
    {
      "name": "productCode",
      "label": "Product",
      "type": "select",
      "required": true
    },
    {
      "name": "accountAlias",
      "label": "Account Alias",
      "type": "text"
    },
    {
      "name": "currency",
      "label": "Currency",
      "type": "select",
      "required": true
    },
    {
      "name": "syntheticInitialDepositAmountMinor",
      "label": "Synthetic Initial Deposit",
      "type": "number"
    },
    {
      "name": "termsAccepted",
      "label": "Terms Accepted",
      "type": "checkbox",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/customer/account-opening-requests",
    "query": "GET /api/customer/account-opening-requests",
    "clientMethod": "requestCustomerAccountOpening",
    "listClientMethod": "customerAccountOpeningRequests",
    "idempotencyPolicy": "body.idempotencyKey",
    "ownershipEnforced": true,
    "syntheticOnly": true,
    "createsAccount": false,
    "createsLedgerPosting": false
