{
  "screenId": "CWB-702",
  "transactionCode": "CWB702",
  "title": "Synthetic Autopay Agreement",
  "app": "customer-web",
  "type": "COMMAND",
  "domain": "payment",
  "highRisk": false,
  "requiredRoles": ["CUSTOMER"],
  "layout": {
    "template": "command",
    "customerContext": true
  },
  "approval": {
    "required": false,
    "makerChecker": false
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": false,
    "maskingPolicy": "CUSTOMER_SELF"
  },
  "fields": [
    {
      "name": "customerId",
      "label": "Customer ID",
      "type": "text",
      "required": true
    },
    {
      "name": "debitAccountId",
      "label": "Debit Account",
      "type": "account-select",
      "required": true
    },
    {
      "name": "billerId",
      "label": "Synthetic Biller",
      "type": "select",
      "required": true
    },
    {
      "name": "amountMinor",
      "label": "Amount",
      "type": "money",
      "required": true
    },
    {
      "name": "currency",
      "label": "Currency",
      "type": "text",
      "required": true
    },
    {
      "name": "frequency",
      "label": "Frequency",
      "type": "select",
      "required": true
    },
    {
      "name": "nextRunOn",
      "label": "Next Run Date",
      "type": "date",
      "required": true
    },
    {
      "name": "requestedBy",
      "label": "Requested By",
      "type": "text",
      "required": true
    },
    {
      "name": "idempotencyKey",
      "label": "Idempotency Key",
      "type": "text",
      "required": true
    },
    {
      "name": "reason",
      "label": "Agreement Reason",
      "type": "textarea",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/payments/autopay/agreements",
    "read": "GET /api/payments/autopay/agreements/{agreementId}"
  },
  "postActions": ["createAuditEvent", "persistAutopayAgreement", "showAutopayStatus"]
}
