{
  "screenId": "CWB-201",
  "transactionCode": "CWB201",
  "title": "Internal Synthetic Transfer",
  "app": "customer-web",
  "type": "COMMAND",
  "domain": "transfer",
  "highRisk": false,
  "requiredRoles": ["CUSTOMER"],
  "layout": {
    "template": "command",
    "customerContext": true
  },
  "approval": {
    "required": false,
    "makerChecker": false
  },
  "audit": {
    "enabled": true,
    "reasonRequired": false,
    "piiAccess": false,
    "selfService": true,
    "maskingPolicy": "CUSTOMER_SELF",
    "eventTypes": ["CUSTOMER_TRANSFER_REQUESTED", "INTERNAL_RECIPIENT_LOOKUP"]
  },
  "fields": [
    {
      "name": "fromAccountId",
      "label": "From Account",
      "type": "owned-account-select",
      "required": true
    },
    {
      "name": "recipientQuery",
      "label": "Recipient Account Number Or ID",
      "type": "internal-recipient-lookup",
      "required": true
    },
    {
      "name": "toAccountId",
      "label": "Resolved Recipient Account",
      "type": "hidden",
      "required": true
    },
    {
      "name": "amountMinor",
      "label": "Amount Minor Units",
      "type": "money",
      "required": true
    },
    {
      "name": "idempotencyKey",
      "label": "Idempotency Key",
      "type": "text",
      "required": true
    }
  ],
  "api": {
    "lookup": "GET /api/customer/recipients/internal-account-lookup",
    "lookupClientMethod": "internalRecipientLookup",
    "command": "POST /api/customer/transfers",
    "clientMethod": "requestCustomerTransfer",
    "idempotencyPolicy": "body.idempotencyKey",
    "ownershipEnforced": true,
    "internalRecipientOnly": true,
    "syntheticOnly": true
  },
  "postActions": ["createAuditEvent", "showReplayStatus", "showTransferResult", "showStructuredErrors"]
}
