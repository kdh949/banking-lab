      },
      {
        "name": "reason",
        "label": "Lookup Reason",
        "type": "textarea",
        "required": true
      }
    ]
  },
  "resultTable": {
    "columns": ["transferReferenceId", "status", "fromAccountId", "toAccountId", "amountMinor", "caseId"]
