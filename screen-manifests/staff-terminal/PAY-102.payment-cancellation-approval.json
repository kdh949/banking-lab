{
  "screenId": "PAY-102",
  "transactionCode": "PAY102",
  "title": "Payment Cancellation Approval",
  "app": "staff-terminal",
  "type": "COMMAND",
  "domain": "payment",
  "highRisk": true,
  "requiredRoles": ["OPS_OPERATOR", "OPS_MANAGER", "BRANCH_MANAGER", "COMPLIANCE_MANAGER"],
  "layout": {
    "template": "command",
    "customerContext": true,
    "tabbed": true
  },
  "approval": {
    "required": true,
    "approverRole": "OPS_MANAGER",
    "makerChecker": true,
    "businessTypes": ["PAYMENT_CANCELLATION"]
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "eventTypes": [
      "PAYMENT_CANCELLATION_REQUESTED",
      "PAYMENT_CANCELLATION_APPROVED",
      "PAYMENT_CANCELLATION_REJECTED",
      "PAYMENT_INSTRUCTION_CANCELED"
    ],
    "piiAccess": true,
    "maskingPolicy": "ACCOUNT_PII"
  },
  "fields": [
    {
      "name": "instructionId",
      "label": "Payment Instruction ID",
      "type": "text",
      "required": true
    },
    {
      "name": "makerReason",
      "label": "Cancellation Request Reason",
      "type": "textarea",
      "required": true
    },
    {
      "name": "checkerReason",
      "label": "Approval Decision Reason",
      "type": "textarea",
      "required": true
    },
    {
      "name": "idempotencyKey",
      "label": "Idempotency Key",
      "type": "text",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/payments/instructions/{instructionId}/cancellation-requests"
  },
  "actions": [
    {
      "id": "approvePaymentCancellation",
      "label": "Approve Cancellation",
      "type": "command",
      "target": "POST /api/payments/cancellation-requests/{requestId}/approve"
    },
    {
      "id": "rejectPaymentCancellation",
      "label": "Reject Cancellation",
      "type": "command",
      "target": "POST /api/payments/cancellation-requests/{requestId}/reject"
    }
  ],
  "postActions": ["createCancellationRequest", "enforceMakerCheckerSeparation", "appendPaymentCanceledOutboxEvent"]
}
