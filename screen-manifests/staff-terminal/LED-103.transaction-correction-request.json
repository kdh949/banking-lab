{
  "screenId": "LED-103",
  "transactionCode": "LED103",
  "title": "Transaction Correction Request",
  "app": "staff-terminal",
  "type": "COMMAND",
  "domain": "ledger",
  "highRisk": true,
  "requiredRoles": ["BRANCH_MANAGER", "OPS_MANAGER"],
  "layout": {
    "template": "command",
    "customerContext": true,
    "tabbed": true
  },
  "approval": {
    "required": true,
    "approverRole": "BRANCH_MANAGER",
    "makerChecker": true,
    "businessTypes": ["TRANSACTION_CORRECTION"]
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "eventTypes": ["TRANSACTION_VIEW", "COMMAND_REQUESTED", "COMMAND_APPROVED", "COMMAND_EXECUTED"],
    "piiAccess": true,
    "maskingPolicy": "ACCOUNT_PII"
  },
  "fields": [
    {
      "name": "transactionId",
      "label": "Original Transaction ID",
      "type": "text",
      "required": true
    },
    {
      "name": "targetAccountId",
      "label": "Target Account ID",
      "type": "text",
      "required": true
    },
    {
      "name": "correctionType",
      "label": "Correction Type",
      "type": "select",
      "required": true,
      "options": ["REVERSAL"]
    },
    {
      "name": "businessDate",
      "label": "Correction Business Date",
      "type": "date",
      "required": true
    },
    {
      "name": "reasonCode",
      "label": "Reason Code",
      "type": "select",
      "required": true,
      "options": ["CUSTOMER_DISPUTE", "STAFF_INPUT_ERROR", "RECONCILIATION_CONFIRMED"]
    },
    {
      "name": "reason",
      "label": "Correction Reason",
      "type": "textarea",
      "required": true
    },
    {
      "name": "idempotencyKey",
      "label": "Idempotency Key",
      "type": "text",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/staff/transactions/{transactionId}/correction-requests"
  },
  "postActions": ["createApprovalRequest", "createAuditEvent", "appendReversalPosting"]
}
