{
  "screenId": "CST-003",
  "transactionCode": "CST003",
  "title": "Customer 360",
  "app": "staff-terminal",
  "type": "INQUIRY",
  "domain": "customer",
  "requiredRoles": ["BRANCH_STAFF", "CALL_CENTER", "BRANCH_MANAGER"],
  "layout": {
    "template": "inquiry",
    "customerContext": true,
    "tabbed": true
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "eventTypes": ["CUSTOMER_360_VIEW"],
    "piiAccess": true,
    "maskingPolicy": "CUSTOMER_PII"
  },
  "query": {
    "endpoint": "GET /api/staff/customers/{customerId}/detail",
    "fields": [
      {
        "name": "customerId",
        "label": "Customer ID",
        "type": "text",
        "required": true
      },
      {
        "name": "reason",
        "label": "Lookup Reason",
        "type": "textarea",
        "required": true
      }
    ]
  },
  "resultTable": {
    "columns": ["customerId", "maskedName", "customerGrade", "riskGrade", "holdCount", "openCaseCount"]
  },
  "actions": [
    {
      "id": "openDetail",
      "label": "Open Detail",
      "type": "navigate",
      "target": "CST-002"
    }
  ]
}
