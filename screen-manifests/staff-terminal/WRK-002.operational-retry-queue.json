{
  "screenId": "WRK-002",
  "transactionCode": "WRK002",
  "title": "Operational Retry Queue",
  "app": "staff-terminal",
  "type": "INQUIRY",
  "domain": "staff-workstation",
  "requiredRoles": ["OPS_MANAGER", "COMPLIANCE_MANAGER", "AUDITOR"],
  "layout": {
    "template": "inquiry",
    "customerContext": false,
    "tabbed": true
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": false,
    "maskingPolicy": "NONE",
    "eventTypes": ["OPERATIONAL_RETRY_QUEUE_VIEW"]
  },
  "query": {
    "endpoint": "GET /api/staff/operations/retry-queue",
    "fields": [
      {
        "name": "status",
        "label": "Status",
        "type": "select",
        "options": ["FAILED", "DEAD_LETTER", "PENDING"]
      },
      {
        "name": "reason",
        "label": "Lookup Reason",
        "type": "text",
        "required": true
      }
    ]
  },
  "resultTable": {
    "columns": [
      "outboxEventId",
      "aggregateType",
      "aggregateId",
      "eventType",
      "status",
      "retryCount",
      "nextRetryAt",
      "retryEligible"
    ]
  },
  "actions": [
    {
      "id": "openAuditLog",
      "label": "Open Audit Log",
      "type": "navigate",
      "target": "AUD-001"
    }
  ]
}
