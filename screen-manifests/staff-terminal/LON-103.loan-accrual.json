{
  "screenId": "LON-103",
  "transactionCode": "LON103",
  "title": "Synthetic Loan Accrual",
  "app": "staff-terminal",
  "type": "COMMAND",
  "domain": "loan",
  "highRisk": false,
  "requiredRoles": ["OPS_OPERATOR", "OPS_MANAGER", "BRANCH_MANAGER"],
  "layout": {
    "template": "command",
    "customerContext": true,
    "tabbed": true
  },
  "approval": {
    "required": false,
    "makerChecker": false
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": false,
    "maskingPolicy": "DEFAULT_STAFF_MASKING"
  },
  "fields": [
    {
      "name": "loanId",
      "label": "Loan ID",
      "type": "text",
      "required": true
    },
    {
      "name": "accrualDate",
      "label": "Accrual Date",
      "type": "date",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/loans/{loanId}/accruals/run"
  },
  "postActions": ["createAuditEvent", "markOverdue"]
}
