{
  "screenId": "PRD-102",
  "transactionCode": "PRD102",
  "title": "Deposit Rate Change Request",
  "app": "staff-terminal",
  "type": "COMMAND",
  "domain": "product-ledger",
  "highRisk": true,
  "requiredRoles": ["OPS_MANAGER", "COMPLIANCE_MANAGER"],
  "layout": {
    "template": "command",
    "customerContext": false,
    "tabbed": true
  },
  "approval": {
    "required": true,
    "approverRole": "COMPLIANCE_MANAGER",
    "makerChecker": true,
    "businessTypes": ["PRODUCT_PARAMETER_CHANGE"]
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": false,
    "maskingPolicy": "NONE"
  },
  "fields": [
    {
      "name": "productId",
      "label": "Product ID",
      "type": "text",
      "required": true
    },
    {
      "name": "requestedAnnualRateBps",
      "label": "Annual Rate Bps",
      "type": "number",
      "required": true
    },
    {
      "name": "effectiveFrom",
      "label": "Effective From",
      "type": "date",
      "required": true
    },
    {
      "name": "reason",
      "label": "Change Reason",
      "type": "textarea",
      "required": true
    },
    {
      "name": "idempotencyKey",
      "label": "Idempotency Key",
      "type": "text",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/staff/products/deposits/{productId}/rate-change-requests"
  },
  "postActions": ["createApprovalRequest", "createAuditEvent", "applyVersionedParameter"]
}
