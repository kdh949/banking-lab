{
  "screenId": "CST-201",
  "transactionCode": "CST201",
  "title": "Synthetic Customer Onboarding Request",
  "app": "staff-terminal",
  "type": "COMMAND",
  "domain": "customer",
  "highRisk": true,
  "requiredRoles": ["BRANCH_STAFF", "BRANCH_MANAGER", "COMPLIANCE_MANAGER"],
  "layout": {
    "template": "command",
    "customerContext": false,
    "tabbed": true
  },
  "approval": {
    "required": true,
    "approverRole": "BRANCH_MANAGER",
    "makerChecker": true,
    "businessTypes": ["CUSTOMER_ONBOARDING"]
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "eventTypes": ["APPROVAL_REQUESTED", "CUSTOMER_ONBOARDING_EXECUTED"],
    "piiAccess": true,
    "maskingPolicy": "CUSTOMER_PII"
  },
  "fields": [
    {
      "name": "customerName",
      "label": "Synthetic Customer Name",
      "type": "text",
      "required": true,
      "mask": "name"
    },
    {
      "name": "customerPhone",
      "label": "Synthetic Phone",
      "type": "text",
      "required": true,
      "mask": "phone"
    },
    {
      "name": "customerAddress",
      "label": "Synthetic Address",
      "type": "textarea",
      "required": true,
      "mask": "address"
    },
    {
      "name": "customerGrade",
      "label": "Customer Grade",
      "type": "select",
      "required": true
    },
    {
      "name": "riskGrade",
      "label": "Risk Grade",
      "type": "select",
      "required": true
    },
    {
      "name": "sourceOfFundsCode",
      "label": "Synthetic Source Of Funds",
      "type": "select",
      "required": true
    },
    {
      "name": "transactionPurposeCode",
      "label": "Synthetic Transaction Purpose",
      "type": "select",
      "required": true
    },
    {
      "name": "username",
      "label": "Synthetic Login Username",
      "type": "text",
      "required": true
    },
    {
      "name": "temporaryPassword",
      "label": "Temporary Password",
      "type": "password",
      "required": true,
      "mask": "secret"
    },
    {
      "name": "idempotencyKey",
      "label": "Idempotency Key",
      "type": "text",
      "required": true
    },
    {
      "name": "reason",
      "label": "Business Reason",
      "type": "textarea",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/staff/customers/onboarding-requests"
  },
  "workflow": {
    "name": "customer-onboarding-maker-checker",
    "states": ["PENDING_APPROVAL", "APPROVED", "REJECTED", "EXECUTED", "FAILED"]
  },
  "postActions": ["createApprovalRequest", "hashTemporaryPassword", "noRealKycProvider", "noKeycloakAdminProvisioning", "createAuditEvent"]
}
