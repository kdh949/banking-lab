{
  "screenId": "SAM-102",
  "transactionCode": "SAM102",
  "title": "AML Closure Request",
  "app": "staff-terminal",
  "type": "COMMAND",
  "domain": "aml",
  "highRisk": true,
  "requiredRoles": ["AML_REVIEWER"],
  "layout": {
    "template": "command",
    "customerContext": true,
    "tabbed": true
  },
  "approval": {
    "required": true,
    "approverRole": "COMPLIANCE_MANAGER",
    "makerChecker": true,
    "businessTypes": ["AML_CLOSURE"]
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": true,
    "maskingPolicy": "CUSTOMER_PII"
  },
  "fields": [
    {
      "name": "caseId",
      "label": "Case ID",
      "type": "text",
      "required": true
    },
    {
      "name": "disposition",
      "label": "Disposition",
      "type": "select",
      "required": true
    },
    {
      "name": "reason",
      "label": "Closure Reason",
      "type": "textarea",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/staff/aml-cases/{caseId}/closure-requests"
  },
  "postActions": ["createApprovalRequest", "createAuditEvent"]
}
