{
  "screenId": "AUD-001",
  "transactionCode": "AUD001",
  "title": "Audit Event Viewer",
  "app": "staff-terminal",
  "type": "INQUIRY",
  "domain": "audit",
  "requiredRoles": ["AUDITOR", "BRANCH_MANAGER"],
  "layout": {
    "template": "inquiry",
    "customerContext": false,
    "tabbed": true
  },
  "audit": {
    "enabled": true,
    "reasonRequired": false,
    "piiAccess": false,
    "maskingPolicy": "NONE"
  },
  "query": {
    "endpoint": "GET /api/staff/audit-events",
    "fields": [
      {
        "name": "eventType",
        "label": "Event Type",
        "type": "select"
      },
      {
        "name": "actorId",
        "label": "Actor ID",
        "type": "text"
      }
    ]
  },
  "resultTable": {
    "columns": ["auditEventId", "eventType", "actorId", "screenId", "reason", "createdAt"]
  },
  "actions": []
}
