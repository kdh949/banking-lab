{
  "screenId": "SFD-103",
  "transactionCode": "SFD103",
  "title": "FDS Block Request",
  "app": "staff-terminal",
  "type": "COMMAND",
  "domain": "fds",
  "highRisk": true,
  "requiredRoles": ["FDS_REVIEWER"],
  "layout": {
    "template": "command",
    "customerContext": true,
    "tabbed": true
  },
  "approval": {
    "required": true,
    "approverRole": "BRANCH_MANAGER",
    "makerChecker": true,
    "businessTypes": ["FDS_BLOCK"]
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": true,
    "maskingPolicy": "CUSTOMER_PII"
  },
  "fields": [
    {
      "name": "caseId",
      "label": "Case ID",
      "type": "text",
      "required": true
    },
    {
      "name": "reason",
      "label": "Block Reason",
      "type": "textarea",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/staff/fds-cases/{caseId}/block-requests"
  },
  "postActions": ["createApprovalRequest", "createAuditEvent"]
}
