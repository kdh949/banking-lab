{
  "screenId": "CMP-202",
  "transactionCode": "CMP202",
  "title": "Complaint Answer Approval",
  "app": "staff-terminal",
  "type": "CASE",
  "domain": "complaint",
  "requiredRoles": ["COMPLAINT_HANDLER", "BRANCH_MANAGER"],
  "layout": {
    "template": "case",
    "customerContext": true,
    "tabbed": true
  },
  "workflow": {
    "name": "complaintAnswerApprovalWorkflow",
    "states": ["IN_REVIEW", "WAITING_APPROVAL", "ANSWERED", "REJECTED"]
  },
  "sla": {
    "enabled": true,
    "targetHours": 72
  },
  "approval": {
    "required": true,
    "approverRole": "BRANCH_MANAGER",
    "makerChecker": true,
    "businessTypes": ["COMPLAINT_ANSWER_SEND"]
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": true,
    "maskingPolicy": "CUSTOMER_PII"
  },
  "sections": ["answerDraft", "customerContext", "approvalTimeline", "timeline"],
  "actions": [
    {
      "id": "approveAnswer",
      "label": "Approve Answer",
      "type": "command",
      "target": "POST /api/staff/approvals/{approvalId}/approve"
    }
  ]
}
