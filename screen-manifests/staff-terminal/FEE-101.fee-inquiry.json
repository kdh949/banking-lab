{
  "screenId": "FEE-101",
  "transactionCode": "FEE101",
  "title": "Fee Inquiry",
  "app": "staff-terminal",
  "type": "INQUIRY",
  "domain": "fee",
  "requiredRoles": ["BRANCH_STAFF", "OPS_OPERATOR"],
  "layout": {
    "template": "inquiry",
    "customerContext": true,
    "tabbed": true
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "eventTypes": ["FEE_VIEW"],
    "piiAccess": true,
    "maskingPolicy": "ACCOUNT_PII"
  },
  "query": {
    "endpoint": "GET /api/staff/fees",
    "fields": [
      {
        "name": "accountId",
        "label": "Account ID",
        "type": "text"
      },
      {
        "name": "reason",
        "label": "Lookup Reason",
        "type": "textarea",
        "required": true
      }
    ]
  },
  "resultTable": {
    "columns": ["feeCode", "feeName", "amountMinor", "waiverEligible", "effectiveFrom"]
  },
  "actions": [
    {
      "id": "requestWaiver",
      "label": "Request Waiver",
      "type": "navigate",
      "target": "FEE-102"
    },
    {
      "id": "requestPolicyChange",
      "label": "Request Policy Change",
      "type": "navigate",
      "target": "FEE-103"
    }
  ]
}
