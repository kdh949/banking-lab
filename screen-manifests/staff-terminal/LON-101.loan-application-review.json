{
  "screenId": "LON-101",
  "transactionCode": "LON101",
  "title": "Synthetic Loan Application Review",
  "app": "staff-terminal",
  "type": "CASE",
  "domain": "loan",
  "highRisk": true,
  "requiredRoles": ["BRANCH_STAFF", "BRANCH_MANAGER", "COMPLIANCE_MANAGER"],
  "layout": {
    "template": "case",
    "customerContext": true,
    "tabbed": true
  },
  "workflow": {
    "name": "loanExecutionWorkflow",
    "states": ["PENDING_APPROVAL", "EXECUTED", "REJECTED", "DECLINED"]
  },
  "approval": {
    "required": true,
    "approverRole": "BRANCH_MANAGER",
    "makerChecker": true,
    "businessTypes": ["LOAN_EXECUTION"]
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": false,
    "maskingPolicy": "DEFAULT_STAFF_MASKING"
  },
  "fields": [
    {
      "name": "applicationId",
      "label": "Application ID",
      "type": "text",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/staff/approvals/{approvalId}/approve"
  },
  "postActions": ["executeLoanDisbursement", "createAuditEvent"]
}
