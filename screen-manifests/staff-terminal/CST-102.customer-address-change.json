{
  "screenId": "CST-102",
  "transactionCode": "CST102",
  "title": "Customer Address Change",
  "app": "staff-terminal",
  "type": "COMMAND",
  "domain": "customer",
  "highRisk": true,
  "requiredRoles": ["BRANCH_STAFF", "CALL_CENTER"],
  "layout": {
    "template": "command",
    "customerContext": true,
    "tabbed": true
  },
  "approval": {
    "required": true,
    "approverRole": "BRANCH_MANAGER",
    "makerChecker": true,
    "businessTypes": ["CUSTOMER_INFO_CHANGE"]
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": true,
    "maskingPolicy": "CUSTOMER_PII"
  },
  "fields": [
    {
      "name": "customerId",
      "label": "Customer ID",
      "type": "text",
      "required": true
    },
    {
      "name": "address",
      "label": "New Address",
      "type": "textarea",
      "mask": "address"
    },
    {
      "name": "reason",
      "label": "Change Reason",
      "type": "textarea",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/staff/customers/{customerId}/change-requests"
  },
  "postActions": ["createApprovalRequest", "createAuditEvent"]
}
