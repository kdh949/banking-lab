{
  "screenId": "KYC-101",
  "transactionCode": "KYC101",
  "title": "Customer KYC Re-confirmation Request",
  "app": "staff-terminal",
  "type": "COMMAND",
  "domain": "kyc",
  "highRisk": true,
  "requiredRoles": ["BRANCH_STAFF", "BRANCH_MANAGER", "COMPLIANCE_MANAGER"],
  "layout": {
    "template": "command",
    "customerContext": true,
    "tabbed": true
  },
  "approval": {
    "required": true,
    "approverRole": "BRANCH_MANAGER",
    "makerChecker": true,
    "businessTypes": ["CUSTOMER_KYC_REVIEW"]
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": true,
    "maskingPolicy": "CUSTOMER_PII"
  },
  "fields": [
    {
      "name": "customerId",
      "label": "Customer ID",
      "type": "text",
      "required": true,
      "mask": "customerId"
    },
    {
      "name": "reasonCode",
      "label": "Review Reason",
      "type": "select",
      "required": true,
      "options": ["PERIODIC_RECONFIRMATION", "RISK_REVIEW", "DOCUMENT_EXPIRY", "STAFF_OBSERVATION"]
    },
    {
      "name": "reviewTrigger",
      "label": "Review Trigger",
      "type": "select",
      "required": true,
      "options": ["PERIODIC_REVIEW", "RISK_GRADE_CHANGE", "DOCUMENT_REFRESH", "BRANCH_REQUEST"]
    },
    {
      "name": "description",
      "label": "Description",
      "type": "textarea",
      "required": true
    },
    {
      "name": "idempotencyKey",
      "label": "Idempotency Key",
      "type": "text",
      "required": true
    },
    {
      "name": "reason",
      "label": "Business Reason",
      "type": "textarea",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/staff/customers/{customerId}/kyc-review-requests"
  },
  "postActions": ["createApprovalRequest", "createAuditEvent"]
}
