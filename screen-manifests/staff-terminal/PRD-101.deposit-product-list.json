    "template": "inquiry",
    "customerContext": false,
    "tabbed": true
  },
  "audit": {
    "enabled": true,
    "reasonRequired": false,
    "piiAccess": false,
    "maskingPolicy": "NONE"
  },
  "query": {
    "endpoint": "GET /api/products/deposits",
    "fields": [
      {
        "name": "asOf",
        "label": "As-of Date",
        "type": "date",
        "required": false
      }
    ]
  },
  "resultTable": {
    "columns": ["productCode", "productName", "currency", "status", "annualRateBps", "rateEffectiveFrom"]
  }
}
