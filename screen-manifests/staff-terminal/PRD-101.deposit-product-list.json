{
  "screenId": "PRD-101",
  "transactionCode": "PRD101",
  "title": "Deposit Product List",
  "app": "staff-terminal",
  "type": "INQUIRY",
  "domain": "product-ledger",
  "highRisk": false,
  "requiredRoles": ["BRANCH_STAFF", "BRANCH_MANAGER", "OPS_MANAGER", "COMPLIANCE_MANAGER"],
