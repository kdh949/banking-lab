{
  "screenId": "LED-101",
  "transactionCode": "LED101",
  "title": "Ledger Transaction History",
  "app": "staff-terminal",
  "type": "INQUIRY",
  "domain": "ledger",
  "requiredRoles": ["BRANCH_STAFF", "CALL_CENTER", "AUDITOR"],
  "layout": {
    "template": "inquiry",
    "customerContext": true,
    "tabbed": true
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": true,
    "maskingPolicy": "ACCOUNT_PII"
  },
  "query": {
    "endpoint": "GET /api/staff/transactions/search",
    "fields": [
      {
        "name": "accountId",
        "label": "Account ID",
        "type": "text",
        "required": true
      },
      {
        "name": "reason",
        "label": "Lookup Reason",
        "type": "textarea",
        "required": true
      }
    ]
  },
  "resultTable": {
    "columns": ["transactionId", "transactionType", "businessDate", "status", "posting"]
  },
  "actions": [
    {
      "id": "openTransactionDetail",
      "label": "Open Transaction Detail",
      "type": "navigate",
      "target": "LED-102"
    }
  ]
}
