{
  "screenId": "LED-102",
  "transactionCode": "LED102",
  "title": "Ledger Transaction Detail",
  "app": "staff-terminal",
  "type": "INQUIRY",
  "domain": "ledger",
  "requiredRoles": ["BRANCH_STAFF", "AUDITOR", "OPS_MANAGER"],
  "layout": {
    "template": "inquiry",
    "customerContext": true,
    "tabbed": true
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "eventTypes": ["TRANSACTION_VIEW"],
    "piiAccess": true,
    "maskingPolicy": "ACCOUNT_PII"
  },
  "query": {
    "endpoint": "GET /api/staff/transactions/{transactionId}",
    "fields": [
      {
        "name": "transactionId",
        "label": "Transaction ID",
        "type": "text",
        "required": true
      },
      {
        "name": "reason",
        "label": "Lookup Reason",
        "type": "textarea",
        "required": true
      }
    ]
  },
  "resultTable": {
    "columns": ["transactionId", "transactionType", "status", "posting", "businessDate", "requestedChannel"]
  },
  "actions": []
}
