{
  "screenId": "ACC-101",
  "transactionCode": "ACC101",
  "title": "Account Inquiry",
  "app": "staff-terminal",
  "type": "INQUIRY",
  "domain": "account",
  "requiredRoles": ["BRANCH_STAFF", "CALL_CENTER"],
  "layout": {
    "template": "inquiry",
    "customerContext": true,
    "tabbed": true
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": true,
    "maskingPolicy": "ACCOUNT_PII"
  },
  "query": {
    "endpoint": "GET /api/staff/accounts/search",
    "fields": [
      {
        "name": "accountNo",
        "label": "Account Number",
        "type": "account-search",
        "required": true,
        "mask": "accountNo"
      },
      {
        "name": "reason",
        "label": "Lookup Reason",
        "type": "textarea",
        "required": true
      }
    ]
  },
  "resultTable": {
    "columns": ["accountId", "maskedAccountNo", "status", "ledgerBalanceMinor", "availableBalanceMinor"]
  },
  "actions": [
    {
      "id": "openLedgerPostings",
      "label": "Open Postings",
      "type": "navigate",
      "target": "LED-101"
    }
  ]
}
