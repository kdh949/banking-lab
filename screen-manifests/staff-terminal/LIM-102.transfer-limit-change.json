{
  "screenId": "LIM-102",
  "transactionCode": "LIM102",
  "title": "Transfer Limit Change Request",
  "app": "staff-terminal",
  "type": "COMMAND",
  "domain": "limit",
  "highRisk": true,
  "requiredRoles": ["BRANCH_STAFF", "BRANCH_MANAGER"],
  "layout": {
    "template": "command",
    "customerContext": true,
    "tabbed": true
  },
  "approval": {
    "required": true,
    "approverRole": "BRANCH_MANAGER",
    "makerChecker": true,
    "businessTypes": ["TRANSFER_LIMIT_CHANGE"]
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "piiAccess": true,
    "maskingPolicy": "CUSTOMER_PII"
  },
  "fields": [
    {
      "name": "accountId",
      "label": "Account ID",
      "type": "text",
      "required": true
    },
    {
      "name": "dailyTransferLimitMinor",
      "label": "Daily Limit",
      "type": "amount",
      "required": true
    },
    {
      "name": "singleTransferLimitMinor",
      "label": "Single Transfer Limit",
      "type": "amount",
      "required": true
    },
    {
      "name": "reasonCode",
      "label": "Reason Code",
      "type": "select",
      "required": true,
      "options": ["CUSTOMER_REQUEST", "RISK_REVIEW", "BRANCH_POLICY"]
    },
    {
      "name": "reason",
      "label": "Change Reason",
      "type": "textarea",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/staff/accounts/{accountId}/limit-change-requests"
  },
  "postActions": ["createApprovalRequest", "createAuditEvent"]
}
