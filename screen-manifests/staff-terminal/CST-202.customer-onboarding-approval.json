{
  "screenId": "CST-202",
  "transactionCode": "CST202",
  "title": "Synthetic Customer Onboarding Approval",
  "app": "staff-terminal",
  "type": "COMMAND",
  "domain": "customer",
  "highRisk": true,
  "requiredRoles": ["BRANCH_MANAGER", "COMPLIANCE_MANAGER", "OPS_MANAGER"],
  "layout": {
    "template": "command",
    "customerContext": false,
    "tabbed": true
  },
  "approval": {
    "required": true,
    "approverRole": "BRANCH_MANAGER",
    "makerChecker": true,
    "businessTypes": ["CUSTOMER_ONBOARDING"]
  },
  "audit": {
    "enabled": true,
    "reasonRequired": true,
    "eventTypes": ["APPROVAL_APPROVED", "APPROVAL_REJECTED", "CUSTOMER_ONBOARDING_EXECUTED"],
    "piiAccess": true,
    "maskingPolicy": "CUSTOMER_PII"
  },
  "fields": [
    {
      "name": "requestId",
      "label": "Onboarding Request ID",
      "type": "text",
      "required": true
    },
    {
      "name": "approvalId",
      "label": "Approval ID",
      "type": "text",
      "required": true
    },
    {
      "name": "approvedBy",
      "label": "Checker ID",
      "type": "text",
      "required": false
    },
    {
      "name": "rejectedBy",
      "label": "Rejecting Checker ID",
      "type": "text",
      "required": false
    },
    {
      "name": "rejectReason",
      "label": "Reject Reason",
      "type": "textarea",
      "required": false
    },
    {
      "name": "executedBy",
      "label": "Executor ID",
      "type": "text",
      "required": false
    },
    {
      "name": "executeIdempotencyKey",
      "label": "Execution Idempotency Key",
      "type": "text",
      "required": false
    },
    {
      "name": "reason",
      "label": "Business Reason",
      "type": "textarea",
      "required": true
    }
  ],
  "api": {
    "command": "POST /api/staff/customers/onboarding-requests/{requestId}/approve | POST /api/staff/customers/onboarding-requests/{requestId}/reject | POST /api/staff/customers/onboarding-requests/{requestId}/execute"
  },
  "workflow": {
    "name": "customer-onboarding-review-execution",
    "states": ["PENDING_APPROVAL", "APPROVED", "REJECTED", "EXECUTED", "FAILED"]
  },
  "postActions": ["enforceSeparationOfDuties", "executeOnlyAfterApproval", "createSyntheticCustomer", "createSyntheticAuthIdentity", "createAuditEvent"]
}
